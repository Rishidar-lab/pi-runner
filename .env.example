# ── Pi Platform (server-side only — never commit real values) ───────────────
# Get this in the Pi Browser: open pi://develop.pinet.com, register/select your
# app, and copy its API key.
PI_API_KEY=

# ── Play-to-earn / Pi Ad Network (all OFF by default) ───────────────────────
# Enable rewarded ads ("watch ad to revive / double coins"). Requires Pi Core
# Team monetization approval. Set to 1 only after approval + testing.
PI_ADS_ENABLED=0

# Enable real-π rewards (App-to-User payouts). Requires Pi approval AND a funded
# app wallet (below). Every claim is re-simulated server-side and capped.
REWARDS_ENABLED=0

# Reward economics (server-enforced maximums)
REWARD_PI_PER_TOKEN=0.001   # real Pi per point of the verified run score
REWARD_DAILY_CAP_PI=0.25    # hard per-user daily payout cap
REWARD_MIN_CLAIM_PI=0.05    # minimum balance before a claim is allowed

# App wallet passphrase for A2U payouts. Provide ONLY on the production host,
# and `npm i pi-backend` there. Keep this secret; treat like a private key.
PI_WALLET_PASSPHRASE=

# ── Node Challenge (SoloHost) ──────────────────────────────────────────────
# All optional. The challenge runs fully locally with none of these set.
#
# NODE_CHALLENGE_SECRET — override the daily-seed namespace key. UNSET (default)
#   uses a fixed PUBLIC namespace, so every Pi Runner node derives the SAME daily
#   seed. Set this only for a private single-node challenge (its leaderboard is
#   then deliberately incomparable with other nodes). Min 8 chars.
# NODE_CHALLENGE_SECRET=
#
# NODE_CHALLENGE_DEMO — set to 1 to allow local (unauthenticated) identities even
#   when PI_API_KEY is set, for demoing without signing in. Never bypasses
#   re-simulation. Leave 0 in production.
NODE_CHALLENGE_DEMO=0
#
# CHALLENGE_RETENTION_DAYS=30       # verified-leaderboard history kept, per node
# CHALLENGE_RUN_TTL_MINUTES=20      # run session lifetime before EXPIRED
# CHALLENGE_BODY_LIMIT=192kb        # max /api/challenge/submit body size

# ── Optional overrides ──────────────────────────────────────────────────────
# PORT=3000
# BIND_HOST=0.0.0.0                 # inside a container; compose maps to 127.0.0.1
# PI_API_BASE=https://api.minepi.com/v2
# DATA_DIR=./server/data
# LOG_LEVEL=info                    # debug | info | warn | error
# DISABLE_CSP=1 / DISABLE_RATE_LIMIT=1   # local debugging only
