# ── Pi Platform (server-side only — never commit real values) ───────────────
# Get this in the Pi Browser: open pi://develop.pinet.com, register/select your
# app, and copy its API key.
PI_API_KEY=

# ── Play-to-earn / Pi Ad Network (all OFF by default) ───────────────────────
# Enable rewarded ads ("watch ad to revive / double coins"). Requires Pi Core
# Team monetization approval. Set to 1 only after approval + testing.
PI_ADS_ENABLED=0

# Enable real-π rewards (App-to-User payouts). Requires Pi approval AND a funded
# app wallet (below). Every claim is re-simulated server-side and capped.
REWARDS_ENABLED=0

# Reward economics (server-enforced maximums)
REWARD_PI_PER_TOKEN=0.001   # real Pi per point of the verified run score
REWARD_DAILY_CAP_PI=0.25    # hard per-user daily payout cap
REWARD_MIN_CLAIM_PI=0.05    # minimum balance before a claim is allowed

# App wallet passphrase for A2U payouts. Provide ONLY on the production host,
# and `npm i pi-backend` there. Keep this secret; treat like a private key.
PI_WALLET_PASSPHRASE=

# ── Optional overrides ──────────────────────────────────────────────────────
# PORT=3000
# PI_API_BASE=https://api.minepi.com/v2
# DATA_DIR=./server/data
